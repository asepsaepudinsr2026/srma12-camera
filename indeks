<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verifikasi Kamera - SRMA 12 Bogor</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #1e3a8a, #2563eb, #06b6d4);
      background-size: 400% 400%;
      animation: gradientMove 15s ease infinite;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      padding: 20px;
    }

    @keyframes gradientMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .container {
      width: 100%;
      max-width: 500px;
      text-align: center;
    }

    .logo {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #facc15, #f97316);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 36px;
      box-shadow: 0 10px 30px rgba(249, 115, 22, 0.4);
    }

    h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: 8px; }
    .subtitle { opacity: 0.9; font-size: 0.95rem; margin-bottom: 30px; }

    .card {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 24px;
      padding: 30px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    }

    .step-badge {
      background: rgba(250, 204, 21, 0.2);
      color: #facc15;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 15px;
    }

    .cam-preview {
      width: 100%;
      max-width: 320px;
      height: 240px;
      background: rgba(0, 0, 0, 0.3);
      border-radius: 16px;
      margin: 0 auto 20px;
      overflow: hidden;
      position: relative;
      border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .cam-preview video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .cam-preview.active video { display: block; }

    .cam-placeholder {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      color: rgba(255, 255, 255, 0.6);
    }

    .cam-placeholder .icon-cam {
      font-size: 48px;
      margin-bottom: 10px;
      display: block;
    }

    .cam-preview.active .cam-placeholder { display: none; }

    .status-text {
      font-size: 0.9rem;
      margin-bottom: 20px;
      min-height: 24px;
    }

    .status-text.success { color: #4ade80; }
    .status-text.error { color: #fca5a5; }

    .btn {
      border: none;
      border-radius: 50px;
      padding: 14px 32px;
      font-family: 'Poppins', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      width: 100%;
      max-width: 280px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #facc15, #f97316);
      color: #111827;
      box-shadow: 0 8px 25px rgba(249, 115, 22, 0.4);
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(249, 115, 22, 0.5);
    }

    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-success {
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: white;
      box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4);
      display: none;
    }

    .btn-success:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(34, 197, 94, 0.5);
    }

    .info-box {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 15px;
      margin-top: 20px;
      font-size: 0.8rem;
      text-align: left;
    }

    .info-box .icon-info {
      margin-right: 8px;
      color: #facc15;
    }

    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 8px;
      vertical-align: middle;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 480px) {
      h1 { font-size: 1.4rem; }
      .card { padding: 20px; }
      .cam-preview { height: 200px; }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="logo">🎓</div>
    <h1>Portal Ujian</h1>
    <p class="subtitle">SRMA 12 Bogor - Verifikasi Keamanan</p>

    <div class="card">
      <div class="step-badge">🔒 Langkah 1: Verifikasi Kamera</div>
      
      <div class="cam-preview" id="camPreview">
        <div class="cam-placeholder">
          <span class="icon-cam">📷</span>
          <div>Kamera Belum Aktif</div>
        </div>
        <video id="videoCam" autoplay playsinline muted></video>
      </div>

      <div class="status-text" id="statusText">
        Sistem mewajibkan webcam laptop aktif sebelum ujian dimulai.
      </div>

      <button class="btn btn-primary" id="btnAktifkan" onclick="aktifkanKamera()">
        📷 Aktifkan Kamera
      </button>

      <button class="btn btn-success" id="btnMulai" onclick="mulaiUjian()">
        🚀 Mulai Ujian
      </button>

      <div class="info-box">
        <span class="icon-info">ℹ️</span>
        <strong>Catatan:</strong> Kamera akan tetap aktif selama ujian berlangsung. 
        Sistem akan mengirim snapshot secara berkala untuk pemantauan pengawas.
      </div>
    </div>
  </div>

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

  <script>
    // ==========================================================
    // KONFIGURASI FIREBASE - GANTI DENGAN CONFIG ANDA
    // ==========================================================
    
    const firebaseConfig = {
      databaseURL: "https://asatsrma12-default-rtdb.asia-southeast1.firebasedatabase.app/"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    // ==========================================================
    // AMBIL PARAMETER DARI URL
    // ==========================================================
    
    const urlParams = new URLSearchParams(window.location.search);
    const nis = urlParams.get('nis') || localStorage.getItem('nis');
    const nama = urlParams.get('nama') || localStorage.getItem('nama');
    const kelas = urlParams.get('kelas') || localStorage.getItem('kelas');
    const scriptUrl = urlParams.get('script') || localStorage.getItem('scriptUrl');

    // Simpan ke localStorage untuk persistensi
    if (nis) localStorage.setItem('nis', nis);
    if (nama) localStorage.setItem('nama', nama);
    if (kelas) localStorage.setItem('kelas', kelas);
    if (scriptUrl) localStorage.setItem('scriptUrl', scriptUrl);

    // ==========================================================
    // CEK PARAMETER
    // ==========================================================
    
    if (!nis || !nama) {
      document.getElementById('statusText').innerHTML = 
        '<span class="error">❌ Data siswa tidak valid. Silakan login ulang dari portal.</span>';
      document.getElementById('btnAktifkan').disabled = true;
    }

    // ==========================================================
    // VARIABEL GLOBAL
    // ==========================================================
    
    let streamKamera = null;
    let intervalSnapshot = null;
    let isCameraActive = false;

    // ==========================================================
    // FUNGSI AKTIFKAN KAMERA
    // ==========================================================
    
    function aktifkanKamera() {
      const btn = document.getElementById('btnAktifkan');
      const status = document.getElementById('statusText');
      const preview = document.getElementById('camPreview');
      const video = document.getElementById('videoCam');

      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Meminta izin...';

      navigator.mediaDevices.getUserMedia({ 
        video: { 
          width: { ideal: 320 },
          height: { ideal: 240 },
          facingMode: 'user'
        } 
      })
      .then(stream => {
        streamKamera = stream;
        video.srcObject = stream;
        
        preview.classList.add('active');
        
        status.innerHTML = '<span class="success">✅ Kamera berhasil diaktifkan!</span>';
        status.className = 'status-text success';
        
        btn.style.display = 'none';
        document.getElementById('btnMulai').style.display = 'inline-block';
        
        isCameraActive = true;

        // Update status ke Firebase
        updateStatusFirebase('Kamera Aktif - Menunggu Ujian');

        // Kirim snapshot pertama
        setTimeout(kirimSnapshot, 1000);
        
        // Mulai kirim snapshot berkala (30 detik)
        intervalSnapshot = setInterval(kirimSnapshot, 30000);

        console.log('Kamera aktif untuk:', nis, nama);
      })
      .catch(err => {
        console.error('Kamera error:', err);
        
        let pesan = '❌ ';
        switch(err.name) {
          case 'NotAllowedError':
            pesan += 'Kamera ditolak. Klik ikon kunci di address bar, lalu izinkan kamera.';
            break;
          case 'NotFoundError':
            pesan += 'Kamera tidak ditemukan. Pastikan webcam terhubung.';
            break;
          case 'NotReadableError':
            pesan += 'Kamera sedang digunakan aplikasi lain (Zoom, Meet, dll).';
            break;
          default:
            pesan += err.message || 'Gagal mengakses kamera.';
        }
        
        status.innerHTML = '<span class="error">' + pesan + '</span>';
        status.className = 'status-text error';
        
        btn.disabled = false;
        btn.innerHTML = '📷 Coba Lagi';
      });
    }

    // ==========================================================
    // KIRIM SNAPSHOT KE FIREBASE
    // ==========================================================
    
    function kirimSnapshot() {
      if (!streamKamera || !isCameraActive) return;

      const video = document.getElementById('videoCam');
      const canvas = document.createElement('canvas');
      canvas.width = 320;
      canvas.height = 240;
      const ctx = canvas.getContext('2d');
      
      // Flip horizontal (mirror effect)
      ctx.translate(canvas.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      
      // Compress ke JPEG quality 0.3
      const base64 = canvas.toDataURL('image/jpeg', 0.3);

      // Simpan ke Firebase
      db.ref('camera/' + nis).set({
        image: base64,
        nama: nama,
        kelas: kelas,
        timestamp: new Date().toISOString(),
        status: 'aktif'
      })
      .then(() => {
        console.log('Snapshot terkirim:', nis);
      })
      .catch(err => {
        console.error('Gagal kirim snapshot:', err);
      });

      // Update monitoring juga
      updateStatusFirebase('Sedang Mengerjakan');
    }

    // ==========================================================
    // UPDATE STATUS KE FIREBASE MONITORING
    // ==========================================================
    
    function updateStatusFirebase(statusText) {
      db.ref('monitoring/' + nis).set({
        nis: nis,
        nama: nama,
        kelas: kelas,
        status: statusText,
        camera: isCameraActive ? 'Aktif' : 'Mati',
        lastUpdate: new Date().toISOString()
      });
    }

    // ==========================================================
    // MULAI UJIAN - REDIRECT KE APPS SCRIPT
    // ==========================================================
    
    function mulaiUjian() {
      if (!isCameraActive) {
        alert('Kamera harus aktif terlebih dahulu!');
        return;
      }

      const btn = document.getElementById('btnMulai');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Memuat ujian...';

      // Update status
      updateStatusFirebase('Sedang Mengerjakan');

      // GANTI URL INI dengan URL deployment Apps Script Anda
      const appsScriptUrl = scriptUrl || 'https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec';
      const redirectUrl = appsScriptUrl + '?page=ujian&nis=' + encodeURIComponent(nis) + 
                          '&nama=' + encodeURIComponent(nama) + 
                          '&kelas=' + encodeURIComponent(kelas);

      // Simpan flag kamera terverifikasi
      localStorage.setItem('cameraVerified', 'true');
      localStorage.setItem('cameraVerifiedAt', new Date().toISOString());

      // Redirect setelah 1 detik
      setTimeout(() => {
        window.location.href = redirectUrl;
      }, 1000);
    }

    // ==========================================================
    // CLEANUP SAAT HALAMAN DITUTUP
    // ==========================================================
    
    window.addEventListener('beforeunload', function() {
      if (streamKamera) {
        streamKamera.getTracks().forEach(track => track.stop());
      }
      if (intervalSnapshot) {
        clearInterval(intervalSnapshot);
      }
    });

    // ==========================================================
    // DETEKSI TAB VISIBILITY (Anti Curang)
    // ==========================================================
    
    document.addEventListener('visibilitychange', function() {
      if (document.hidden && isCameraActive) {
        // Kirim pelanggaran ke Firebase
        db.ref('monitoring/' + nis).update({
          pelanggaran: 'Pindah Tab pada ' + new Date().toLocaleTimeString('id-ID'),
          status: '⚠️ TERDETEKSI CURANG'
        });
        
        db.ref('logs').push({
          timestamp: new Date().toISOString(),
          aksi: 'PELANGGARAN',
          detail: 'Siswa pindah tab saat verifikasi kamera',
          user: nama + ' (' + nis + ')'
        });
      }
    });
  </script>
</body>
</html>
